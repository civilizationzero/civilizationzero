{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "civilization-zero.vercel.app"
        }
      ],
      "destination": "https://civilizationzero.ai/:path*",
      "permanent": true
    },
    {
      "source": "/:page(discuss|respond).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/core.:lang([a-z]{2,3}|[a-z]{2,3}-[A-Za-z0-9]+).html",
      "destination": "/core.:lang",
      "permanent": true
    },
    {
      "source": "/:page(core|record|objections|ask|machine|about|archive).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)application/json(.*)"
        }
      ],
      "destination": "/api/home?f=json"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^((?!text/html).)*text/plain(.*)"
        }
      ],
      "destination": "/api/home?f=txt"
    },
    {
      "source": "/core",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)application/json(.*)"
        }
      ],
      "destination": "/core.json"
    },
    {
      "source": "/core",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^((?!text/html).)*text/plain(.*)"
        }
      ],
      "destination": "/core.txt"
    },
    {
      "source": "/record",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)application/json(.*)"
        }
      ],
      "destination": "/record.json"
    },
    {
      "source": "/record",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^((?!text/html).)*text/plain(.*)"
        }
      ],
      "destination": "/record.txt"
    },
    {
      "source": "/discuss",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)application/json(.*)"
        }
      ],
      "destination": "/api/archive"
    },
    {
      "source": "/adopt",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)application/json(.*)"
        }
      ],
      "destination": "/api/adopt?page=json"
    },
    {
      "source": "/adopt/:id(\\d{1,12})",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)application/json(.*)"
        }
      ],
      "destination": "/api/adopt?id=:id"
    },
    {
      "source": "/",
      "destination": "/api/home?f=html"
    },
    {
      "source": "/index.json",
      "destination": "/api/home?f=json"
    },
    {
      "source": "/index.txt",
      "destination": "/api/home?f=txt"
    },
    {
      "source": "/core",
      "destination": "/core.html"
    },
    {
      "source": "/core.:lang([a-z]{2,3}|[a-z]{2,3}-[A-Za-z0-9]+)",
      "destination": "/core.:lang.html"
    },
    {
      "source": "/record",
      "destination": "/record.html"
    },
    {
      "source": "/objections",
      "destination": "/objections.html"
    },
    {
      "source": "/discuss",
      "destination": "/api/discuss"
    },
    {
      "source": "/respond",
      "destination": "/api/discuss?page=respond"
    },
    {
      "source": "/ask",
      "destination": "/ask.html"
    },
    {
      "source": "/machine",
      "destination": "/machine.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/archive",
      "destination": "/archive.html"
    },
    {
      "source": "/adopt",
      "destination": "/api/adopt?page=list"
    },
    {
      "source": "/adopt.json",
      "destination": "/api/adopt?page=json"
    },
    {
      "source": "/adopt/:id(\\d{1,12})",
      "destination": "/api/adopt?page=record&id=:id"
    },
    {
      "source": "/api/entries/:id",
      "destination": "/api/entries?id=:id"
    },
    {
      "source": "/discuss/:id",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)application/json(.*)"
        }
      ],
      "destination": "/api/entries?id=:id"
    },
    {
      "source": "/discuss/:id",
      "destination": "/api/discuss?id=:id"
    },
    {
      "source": "/discuss.json",
      "destination": "/api/archive"
    },
    {
      "source": "/archive/entries.json",
      "destination": "/api/archive?index=1"
    },
    {
      "source": "/archive/register.json",
      "destination": "/api/archive?index=1&chain=register"
    },
    {
      "source": "/archive/register/:date(\\d{4}-\\d{2}-\\d{2}).json",
      "destination": "/api/archive?date=:date&chain=register"
    },
    {
      "source": "/archive/entries/:date(\\d{4}-\\d{2}-\\d{2}).json",
      "destination": "/api/archive?date=:date"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "civilizationzero.ai"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/core",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</core.txt>; rel=\"alternate\"; type=\"text/plain\", </core.json>; rel=\"alternate\"; type=\"application/json\", </api/openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\""
        }
      ]
    },
    {
      "source": "/record",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</record.txt>; rel=\"alternate\"; type=\"text/plain\", </record.json>; rel=\"alternate\"; type=\"application/json\", </api/openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\""
        }
      ]
    },
    {
      "source": "/discuss",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</discuss.json>; rel=\"alternate\"; type=\"application/json\""
        }
      ]
    },
    {
      "source": "/(core|record|llms|robots|sitemap).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/prompts/(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(core|record|objections).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/core.schema.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/schema+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.oai.openapi+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/civilization-zero.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/archive/(.*).tar",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-tar"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/.well-known/cz-release-1.0.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/cz-record-signing.pub",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).sig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).ots",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).tsr",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/timestamp-reply"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/tsa/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-pem-file"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/discuss.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/api/moderation",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/discuss/:id",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/archive/verify.py",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/adopt",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</adopt.json>; rel=\"alternate\"; type=\"application/json\""
        }
      ]
    },
    {
      "source": "/(og.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(admin|api/admin)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "20 0 * * *"
    }
  ],
  "functions": {
    "api/archive.js": {
      "maxDuration": 60
    },
    "api/cron/daily.js": {
      "maxDuration": 60
    },
    "api/entries.js": {
      "maxDuration": 30
    },
    "api/discuss.js": {
      "maxDuration": 30
    },
    "api/moderation.js": {
      "maxDuration": 30
    },
    "api/adopt.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 30
    }
  }
}
